# Copy to .env.local and fill in. Never commit real values.

# Supabase — from your own project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server + crawler only; bypasses RLS, must never reach the browser
SUPABASE_SERVICE_ROLE_KEY=
# used by the integration tests to mint user sessions
SUPABASE_JWT_SECRET=
# direct Postgres connection string, used by `npm run migrate`
POSTGRES_URL=

# comma-separated campus mail domains allowed to post reviews
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=mail.nknu.edu.tw

# optional: site origin for sitemap + OG tags (defaults to http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# optional: without a key the AI advisor shows "not enabled"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
